<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Abort the whole run if it takes longer than 5 minutes (includes building and starting the portal). -->
    <TestSessionTimeout>300000</TestSessionTimeout>
  </RunConfiguration>
  <MSTest>
    <!-- Fail any single test that takes longer than 30 seconds rather than hanging. -->
    <TestTimeout>30000</TestTimeout>
  </MSTest>
</RunSettings>
