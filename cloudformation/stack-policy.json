{
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": "*",
      "Action": "Update:*",
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["Update:Replace", "Update:Delete"],
      "Resource": [
        "LogicalResourceId/UserPool",
        "LogicalResourceId/IdentityPool",
        "LogicalResourceId/DataBucket"
      ]
    }
  ]
}
