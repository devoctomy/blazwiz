@page "/settings"
@inherits MvvmComponentBase<SettingsViewModel>
@*#if (IncludeNotes)*@
@using blazwiz.Core.Sync.Models
@*#endif*@

<PageHeader Title="Settings" Icon="bi-gear" Subtitle="Preferences are saved in this browser." />

<div class="panel mb-4">
    <h2 class="panel-title">Appearance</h2>
    <p class="panel-text">Choose how the app looks. The default follows your operating system.</p>
    <div class="theme-options">
        <button type="button"
                class="theme-option @(ViewModel.CurrentTheme == ThemeNames.Light ? "active" : null)"
                id="theme-option-light"
                @onclick="() => ViewModel.SelectThemeCommand.ExecuteAsync(ThemeNames.Light)">
            <span class="theme-preview theme-preview-light">
                <span></span><span></span><span></span>
            </span>
            <span class="theme-option-label"><i class="bi bi-sun me-1"></i>Light</span>
        </button>
        <button type="button"
                class="theme-option @(ViewModel.CurrentTheme == ThemeNames.Dark ? "active" : null)"
                id="theme-option-dark"
                @onclick="() => ViewModel.SelectThemeCommand.ExecuteAsync(ThemeNames.Dark)">
            <span class="theme-preview theme-preview-dark">
                <span></span><span></span><span></span>
            </span>
            <span class="theme-option-label"><i class="bi bi-moon-stars me-1"></i>Dark</span>
        </button>
    </div>
</div>

<div class="panel mb-4" id="offline-card">
    <h2 class="panel-title">Offline mode</h2>
    <p class="panel-text">Work without connecting to the sign-in service or the cloud.</p>
    <OfflineModeSwitch />
</div>

@*#if (IncludeNotes)*@
<div class="panel mb-4" id="sync-card">
    <h2 class="panel-title">Sync</h2>
    <p class="panel-text">Your notes are kept in this browser and synced with your cloud storage when you are online.</p>
    <dl class="detail-list">
        <dt>State</dt>
        <dd id="settings-sync-state"><i class="bi @ViewModel.SyncDisplay.Icon sync-tone-@ViewModel.SyncDisplay.Tone me-1"></i>@ViewModel.SyncDisplay.Text</dd>
        <dt>Connection</dt>
        <dd id="settings-connectivity">@ViewModel.ConnectivityText</dd>
        <dt>Last synced</dt>
        <dd id="settings-last-synced">@(ViewModel.SyncStatus.LastSyncedAt?.ToLocalTime().ToString("g") ?? "Not yet")</dd>
        <dt>Pending changes</dt>
        <dd id="settings-pending">@ViewModel.SyncStatus.PendingCount</dd>
        @if (!string.IsNullOrEmpty(ViewModel.SyncStatus.LastError))
        {
            <dt>Last error</dt>
            <dd id="settings-last-error" class="text-danger">@ViewModel.SyncStatus.LastError</dd>
        }
        <dt>Storage</dt>
        <dd id="storage-status">
            @if (ViewModel.IsStoragePersisted)
            {
                <span class="text-success"><i class="bi bi-check-lg me-1"></i>@ViewModel.StorageText</span>
            }
            else if (ViewModel.IsStorageKnown)
            {
                <span class="text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>@ViewModel.StorageText</span>
                @if (ViewModel.ShowInstallHint)
                {
                    <div class="form-text" id="storage-install-hint">@SettingsViewModel.InstallHint</div>
                }
            }
            else
            {
                <span class="text-body-secondary">@ViewModel.StorageText</span>
            }
        </dd>
    </dl>
    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
        <button type="button" class="btn btn-primary" id="settings-sync-now"
                disabled="@(!ViewModel.CanSyncNow)"
                @onclick="() => ViewModel.SyncNowCommand.ExecuteAsync(null)">
            <i class="bi bi-arrow-repeat me-1"></i>Sync now
        </button>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="settings-sync-switch"
                   checked="@ViewModel.IsSyncEnabled"
                   @onchange="() => ViewModel.ToggleSyncCommand.ExecuteAsync(null)" />
            <label class="form-check-label" for="settings-sync-switch">Sync</label>
        </div>
        <a href="sync" class="btn btn-link">View sync log</a>
    </div>
    @if (ViewModel.CanSwitchStorage)
    {
        <div class="mt-4" id="storage-location">
            <h3 class="h6 mb-1">Storage location</h3>
            <p class="panel-text mb-2">Where your notes are kept on this device. Sync pauses while they are moved.</p>
            <div class="btn-group flex-wrap" role="group" aria-label="Storage location">
                <button type="button" id="storage-option-indexeddb"
                        class="btn btn-outline-primary @(ViewModel.StorageKind == SyncStorageKind.IndexedDb ? "active" : null)"
                        aria-pressed="@(ViewModel.StorageKind == SyncStorageKind.IndexedDb ? "true" : "false")"
                        disabled="@ViewModel.IsMigrating"
                        title="Kept in the browser's database (IndexedDB)"
                        @onclick="() => ViewModel.RequestStorageChangeCommand.ExecuteAsync(SyncStorageKind.IndexedDb)">
                    <i class="bi bi-database me-1"></i>@ViewModel.GetStorageName(SyncStorageKind.IndexedDb)
                </button>
                <button type="button" id="storage-option-opfs"
                        class="btn btn-outline-primary @(ViewModel.StorageKind == SyncStorageKind.Opfs ? "active" : null)"
                        aria-pressed="@(ViewModel.StorageKind == SyncStorageKind.Opfs ? "true" : "false")"
                        disabled="@(ViewModel.IsMigrating || !ViewModel.IsOpfsSupported)"
                        title="@(ViewModel.IsOpfsSupported ? "Files kept privately by the browser (origin private file system)" : "This browser cannot keep files in OPFS")"
                        @onclick="() => ViewModel.RequestStorageChangeCommand.ExecuteAsync(SyncStorageKind.Opfs)">
                    <i class="bi bi-hdd me-1"></i>@ViewModel.GetStorageName(SyncStorageKind.Opfs)
                </button>
                <button type="button" id="storage-option-folder"
                        class="btn btn-outline-primary @(ViewModel.StorageKind == SyncStorageKind.LocalFolder ? "active" : null)"
                        aria-pressed="@(ViewModel.StorageKind == SyncStorageKind.LocalFolder ? "true" : "false")"
                        disabled="@(ViewModel.IsMigrating || !ViewModel.IsFolderSupported)"
                        title="@(ViewModel.IsFolderSupported ? "A folder you pick, which you can open outside the app (File System Access API)" : "This browser cannot keep files in a folder you pick")"
                        @onclick="() => ViewModel.RequestStorageChangeCommand.ExecuteAsync(SyncStorageKind.LocalFolder)">
                    <i class="bi bi-folder2-open me-1"></i>@ViewModel.GetStorageName(SyncStorageKind.LocalFolder)
                </button>
            </div>
            @if (ViewModel.StorageKind == SyncStorageKind.LocalFolder && !string.IsNullOrEmpty(ViewModel.FolderName))
            {
                <div class="form-text" id="storage-folder-name"><i class="bi bi-folder2-open me-1"></i>Folder: @ViewModel.FolderName</div>
            }
            @if (!string.IsNullOrEmpty(ViewModel.StorageError))
            {
                <div class="text-danger mt-2" id="storage-error">@ViewModel.StorageError</div>
            }
        </div>
    }
    <E2eEncryptionSection />
</div>

@if (ViewModel.IsStorageDialogOpen)
{
    <ModalDialog Id="storage-dialog" Title="Move your notes?" Icon="bi-arrow-left-right" OnClose="() => ViewModel.CloseStorageDialogCommand.Execute(null)">
        <ChildContent>
            @if (ViewModel.IsMigrating)
            {
                <p class="mb-0" id="storage-migration-progress">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@(ViewModel.MigrationText ?? "Pausing sync…")
                </p>
            }
            else
            {
                <p id="storage-dialog-summary">@(ViewModel.PendingFileCount == 1 ? "1 file" : $"{ViewModel.PendingFileCount} files") will be moved to <strong>@ViewModel.PendingStorageName</strong> on this device.</p>
                <p class="mb-0">When online, anything not yet on this device is synced first. Sync then pauses while they move. Other tabs of the app reload when it finishes. Nothing is uploaded again.</p>
            }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" disabled="@ViewModel.IsMigrating" @onclick="() => ViewModel.CloseStorageDialogCommand.Execute(null)">Cancel</button>
            <button type="button" class="btn btn-primary" id="storage-confirm" disabled="@ViewModel.IsMigrating" @onclick="() => ViewModel.ConfirmStorageChangeCommand.ExecuteAsync(null)">Move files</button>
        </Footer>
    </ModalDialog>
}

<Argon2idPanel />

@*#endif*@
<div class="panel">
    <h2 class="panel-title">About</h2>
    <dl class="detail-list">
        <dt>Version</dt>
        <dd id="app-version">@Globals.Version</dd>
        <dt>Build</dt>
        <dd>@(Globals.IsDebugBuild ? "Debug" : "Release")</dd>
        <dt>Built</dt>
        <dd id="app-build-time">@(Globals.BuildTime is { } built ? $"{built} UTC" : "Not stamped (development build)")</dd>
    </dl>
</div>
