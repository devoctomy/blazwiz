@page "/settings"
@inherits MvvmComponentBase<SettingsViewModel>

<PageHeader Title="Settings" Icon="bi-gear" Subtitle="Preferences are saved in this browser." />

<div class="panel mb-4">
    <h2 class="panel-title">Appearance</h2>
    <p class="panel-text">Choose how the app looks. The default follows your operating system.</p>
    <div class="theme-options">
        <button type="button"
                class="theme-option @(ViewModel.CurrentTheme == ThemeNames.Light ? "active" : null)"
                id="theme-option-light"
                @onclick="() => ViewModel.SelectThemeCommand.ExecuteAsync(ThemeNames.Light)">
            <span class="theme-preview theme-preview-light">
                <span></span><span></span><span></span>
            </span>
            <span class="theme-option-label"><i class="bi bi-sun me-1"></i>Light</span>
        </button>
        <button type="button"
                class="theme-option @(ViewModel.CurrentTheme == ThemeNames.Dark ? "active" : null)"
                id="theme-option-dark"
                @onclick="() => ViewModel.SelectThemeCommand.ExecuteAsync(ThemeNames.Dark)">
            <span class="theme-preview theme-preview-dark">
                <span></span><span></span><span></span>
            </span>
            <span class="theme-option-label"><i class="bi bi-moon-stars me-1"></i>Dark</span>
        </button>
    </div>
</div>

@*#if (IncludeNotes)*@
<div class="panel mb-4" id="sync-card">
    <h2 class="panel-title">Sync</h2>
    <p class="panel-text">Your notes are kept in this browser and synced with your cloud storage when you are online.</p>
    <dl class="detail-list">
        <dt>State</dt>
        <dd id="settings-sync-state"><i class="bi @ViewModel.SyncDisplay.Icon sync-tone-@ViewModel.SyncDisplay.Tone me-1"></i>@ViewModel.SyncDisplay.Text</dd>
        <dt>Connection</dt>
        <dd id="settings-connectivity">@ViewModel.ConnectivityText</dd>
        <dt>Last synced</dt>
        <dd id="settings-last-synced">@(ViewModel.SyncStatus.LastSyncedAt?.ToLocalTime().ToString("g") ?? "Not yet")</dd>
        <dt>Pending changes</dt>
        <dd id="settings-pending">@ViewModel.SyncStatus.PendingCount</dd>
        @if (!string.IsNullOrEmpty(ViewModel.SyncStatus.LastError))
        {
            <dt>Last error</dt>
            <dd id="settings-last-error" class="text-danger">@ViewModel.SyncStatus.LastError</dd>
        }
        <dt>Storage</dt>
        <dd id="storage-status">
            @if (ViewModel.IsStoragePersisted)
            {
                <span class="text-success"><i class="bi bi-check-lg me-1"></i>@ViewModel.StorageText</span>
            }
            else if (ViewModel.IsStorageKnown)
            {
                <span class="text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>@ViewModel.StorageText</span>
                @if (ViewModel.ShowInstallHint)
                {
                    <div class="form-text" id="storage-install-hint">@SettingsViewModel.InstallHint</div>
                }
            }
            else
            {
                <span class="text-body-secondary">@ViewModel.StorageText</span>
            }
        </dd>
    </dl>
    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
        <button type="button" class="btn btn-primary" id="settings-sync-now"
                disabled="@(!ViewModel.CanSyncNow)"
                @onclick="() => ViewModel.SyncNowCommand.ExecuteAsync(null)">
            <i class="bi bi-arrow-repeat me-1"></i>Sync now
        </button>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="settings-offline-switch"
                   checked="@ViewModel.IsForcedOffline"
                   @onchange="() => ViewModel.ToggleOfflineModeCommand.ExecuteAsync(null)" />
            <label class="form-check-label" for="settings-offline-switch">Offline mode</label>
        </div>
        <a href="sync" class="btn btn-link">View sync log</a>
    </div>
</div>

@*#endif*@
<div class="panel">
    <h2 class="panel-title">About</h2>
    <dl class="detail-list">
        <dt>Version</dt>
        <dd id="app-version">@Globals.Version</dd>
        <dt>Build</dt>
        <dd>@(Globals.IsDebugBuild ? "Debug" : "Release")</dd>
    </dl>
</div>
