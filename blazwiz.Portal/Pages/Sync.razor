@page "/sync"
@inherits MvvmComponentBase<SyncViewModel>
@using blazwiz.Portal.Models.Sync

<PageHeader Title="Sync" Icon="bi-arrow-repeat" Subtitle="Everything sync has done on this device.">
    <div class="form-check form-switch mb-0 me-2">
        <input class="form-check-input" type="checkbox" role="switch" id="sync-page-sync-switch"
               checked="@ViewModel.IsSyncEnabled"
               @onchange="() => ViewModel.ToggleSyncCommand.ExecuteAsync(null)" />
        <label class="form-check-label" for="sync-page-sync-switch">Sync</label>
    </div>
    <button type="button" class="btn btn-outline-danger" id="clear-sync-log" @onclick="() => ViewModel.ShowClearDialogCommand.Execute(null)">
        <i class="bi bi-trash3 me-1"></i>Clear log
    </button>
    <button type="button" class="btn btn-primary" id="sync-page-sync-now"
            disabled="@(!ViewModel.CanSyncNow)"
            @onclick="() => ViewModel.SyncNowCommand.ExecuteAsync(null)">
        <i class="bi bi-arrow-repeat me-1"></i>Sync now
    </button>
</PageHeader>

<div class="panel mb-4 sync-summary" id="sync-summary">
    <div class="sync-summary-item">
        <span class="sync-summary-label">Status</span>
        <span class="sync-summary-value" id="sync-page-status" title="@ViewModel.Status.Tooltip">
            <i class="bi @ViewModel.Status.Icon sync-tone-@ViewModel.Status.Tone me-1"></i>@ViewModel.Status.Text
        </span>
        <small class="text-body-secondary" id="sync-page-reason">@ViewModel.Status.Tooltip</small>
    </div>
    <div class="sync-summary-item">
        <span class="sync-summary-label">Last synced</span>
        <span class="sync-summary-value">@(ViewModel.SyncStatus.LastSyncedAt?.ToLocalTime().ToString("g") ?? "Not yet")</span>
    </div>
    <div class="sync-summary-item">
        <span class="sync-summary-label">Pending changes</span>
        <span class="sync-summary-value" id="sync-page-pending">@ViewModel.SyncStatus.PendingCount</span>
    </div>
</div>

<div class="sync-toolbar">
    <div class="input-icon sync-search">
        <i class="bi bi-search"></i>
        <input type="search"
               id="sync-search"
               class="form-control"
               placeholder="Search messages, files and profiles"
               aria-label="Search the sync log"
               @bind="ViewModel.SearchText"
               @bind:event="oninput" />
    </div>
    <div class="sync-filters" role="group" aria-label="Filter the sync log">
        @foreach (var chip in ViewModel.Chips)
        {
            <button type="button"
                    class="sync-filter @(chip.IsActive ? "active" : null)"
                    data-group="@(chip.Group?.ToString() ?? "All")"
                    aria-pressed="@chip.IsActive.ToString().ToLowerInvariant()"
                    @onclick="() => ViewModel.SelectGroupCommand.ExecuteAsync(chip.Group)">
                @chip.Label
            </button>
        }
    </div>
    @if (ViewModel.ShowProfileFilter)
    {
        <select class="form-select sync-profile-filter" id="sync-profile-filter" aria-label="Profile"
                @onchange="e => ViewModel.SelectProfileCommand.ExecuteAsync(e.Value?.ToString())">
            <option value="" selected="@(ViewModel.ActiveProfile == null)">All profiles</option>
            @foreach (var profile in ViewModel.Profiles)
            {
                <option value="@profile" selected="@(ViewModel.ActiveProfile == profile)">@profile</option>
            }
        </select>
    }
</div>

<div class="panel sync-log" id="sync-log">
    @if (ViewModel.IsLoading)
    {
        <div class="sync-log-empty">
            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>Loading the sync log...
        </div>
    }
    else if (ViewModel.Days.Count == 0)
    {
        <div class="sync-log-empty" id="sync-log-empty">
            <i class="bi bi-journal-check"></i>
            <p class="mb-0">Nothing to show.</p>
        </div>
    }
    else
    {
        @foreach (var day in ViewModel.Days)
        {
            <h3 class="sync-day">@day.Label</h3>
            <ul class="sync-rows">
                @foreach (var row in day.Rows)
                {
                    <li @key="row.Id" class="sync-row @(row.HasErrors ? "has-errors" : null)" data-kind="@row.Header.Presentation.Group">
                        <div class="sync-row-main">
                            @if (row.Children.Count > 0)
                            {
                                <button type="button" class="sync-row-toggle" title="@(row.IsExpanded ? "Collapse" : "Expand")"
                                        aria-expanded="@row.IsExpanded.ToString().ToLowerInvariant()"
                                        @onclick="() => ViewModel.ToggleRowCommand.Execute(row.Id)">
                                    <i class="bi @(row.IsExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                </button>
                            }
                            else
                            {
                                <span class="sync-row-toggle-spacer"></span>
                            }
                            @Entry(row.Header)
                        </div>
                        @if (row.IsExpanded && row.Children.Count > 0)
                        {
                            <ul class="sync-row-children">
                                @foreach (var child in row.Children)
                                {
                                    <li @key="child.Id" class="sync-entry-row">@Entry(child)</li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        }

        @if (ViewModel.HasMore)
        {
            <div class="text-center mt-3">
                <button type="button" class="btn btn-outline-primary btn-sm" id="sync-load-more" @onclick="() => ViewModel.LoadMoreCommand.ExecuteAsync(null)">Load more</button>
            </div>
        }
    }
</div>

@if (ViewModel.IsClearDialogOpen)
{
    <ModalDialog Id="clear-log-dialog" Title="Clear the sync log?" Icon="bi-trash3" OnClose="() => ViewModel.CloseClearDialogCommand.Execute(null)">
        <ChildContent>
            <p class="mb-0">Every entry in this device's sync log will be removed. Your files are not affected.</p>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="() => ViewModel.CloseClearDialogCommand.Execute(null)">Cancel</button>
            <button type="button" class="btn btn-danger" id="clear-log-confirm" @onclick="() => ViewModel.ClearLogCommand.ExecuteAsync(null)">Clear log</button>
        </Footer>
    </ModalDialog>
}

@code {
    private RenderFragment Entry(SyncLogEntry entry) =>
        @<div class="sync-entry" data-kind="@entry.Presentation.Label">
            <i class="bi @entry.Presentation.Icon @entry.Presentation.ColorClass sync-entry-icon" title="@entry.Presentation.Label"></i>
            <span class="sync-entry-text">
                <span class="sync-entry-message">@entry.Message</span>
                @if (entry.Count > 1)
                {
                    <span class="badge text-bg-secondary ms-1 sync-entry-count">×@entry.Count</span>
                }
                @if (!string.IsNullOrEmpty(entry.Key))
                {
                    <span class="sync-entry-key">@entry.Key</span>
                }
                @if (entry.Presentation.Group == SyncEventGroup.Errors && !string.IsNullOrEmpty(entry.Detail))
                {
                    <span class="sync-entry-detail">@entry.Detail.Split('\n')[0]</span>
                }
            </span>
            <time class="sync-entry-time" title="@entry.ExactTime" datetime="@entry.Timestamp.ToString("O")">@entry.RelativeTime</time>
        </div>;
}
