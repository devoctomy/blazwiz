@page "/not-found"
@layout LoginLayout
@inject IStringLocalizer<UiText> Text

<PageTitle>@Text["NotFound.PageTitle"]</PageTitle>

<div class="auth-card text-center">
    <div class="not-found-code">404</div>
    <h1 class="auth-title">@Text["NotFound.Title"]</h1>
    <p class="auth-subtitle mb-4">@Text["NotFound.Text"]</p>
    <a class="btn btn-primary" href="">
        <i class="bi bi-house me-1"></i>@Text["NotFound.BackHome"]
    </a>
</div>
