@inherits MvvmLayoutComponentBase<MainLayoutViewModel>

@if (!ViewModel.IsReady)
{
    <div class="app-splash">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="app-shell @(ViewModel.IsSidebarCollapsed ? "sidebar-collapsed" : null) @(ViewModel.IsMobileMenuOpen ? "mobile-menu-open" : null)">
        <aside class="sidebar" id="sidebar" aria-label="Main navigation">
            <div class="sidebar-brand">
                <img src="images/icon.svg" class="brand-icon" alt="@ViewModel.AppSettings.ApplicationTitle" />
                <span class="brand-name sidebar-label">@ViewModel.AppSettings.ApplicationTitle</span>
            </div>

            <nav class="sidebar-nav">
                @foreach (var item in ViewModel.NavigationItems)
                {
                    <NavLink class="sidebar-link"
                             href="@item.Href"
                             Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                             title="@item.Text"
                             id="@($"nav-{(string.IsNullOrEmpty(item.Href) ? "dashboard" : item.Href)}")"
                             @onclick="() => ViewModel.CloseMobileMenuCommand.Execute(null)">
                        <i class="bi @item.Icon"></i>
                        <span class="sidebar-label">@item.Text</span>
                    </NavLink>
                }
            </nav>

            <div class="sidebar-footer">
                <NavLink class="sidebar-link sidebar-user"
                         href="profile"
                         id="nav-profile"
                         title="@ViewModel.CurrentUser?.DisplayName"
                         @onclick="() => ViewModel.CloseMobileMenuCommand.Execute(null)">
                    <span class="avatar">@ViewModel.UserInitials</span>
                    <span class="sidebar-label user-meta">
                        <span class="user-name">@ViewModel.CurrentUser?.DisplayName</span>
                        <small class="user-sub">@(ViewModel.CurrentUser?.Email ?? ViewModel.CurrentUser?.Username)</small>
                    </span>
                </NavLink>
                <button type="button"
                        class="sidebar-link sidebar-logout"
                        id="logout-button"
                        title="Log out"
                        @onclick="() => ViewModel.LogoutCommand.ExecuteAsync(null)">
                    <i class="bi bi-box-arrow-left"></i>
                    <span class="sidebar-label">Log out</span>
                </button>
            </div>
        </aside>

        <div class="sidebar-backdrop" @onclick="() => ViewModel.CloseMobileMenuCommand.Execute(null)"></div>

        <div class="app-main">
            <header class="topbar">
                <button type="button"
                        class="icon-btn d-none d-md-inline-flex"
                        id="sidebar-toggle"
                        title="@(ViewModel.IsSidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                        aria-controls="sidebar"
                        aria-expanded="@((!ViewModel.IsSidebarCollapsed).ToString().ToLowerInvariant())"
                        @onclick="() => ViewModel.ToggleSidebarCommand.ExecuteAsync(null)">
                    <i class="bi @(ViewModel.IsSidebarCollapsed ? "bi-layout-sidebar" : "bi-layout-sidebar-inset")"></i>
                </button>
                <button type="button"
                        class="icon-btn d-md-none"
                        id="mobile-menu-toggle"
                        title="Menu"
                        aria-controls="sidebar"
                        aria-expanded="@ViewModel.IsMobileMenuOpen.ToString().ToLowerInvariant()"
                        @onclick="() => ViewModel.ToggleMobileMenuCommand.Execute(null)">
                    <i class="bi bi-list"></i>
                </button>
                <span class="topbar-title d-md-none">@ViewModel.AppSettings.ApplicationTitle</span>

                <div class="flex-grow-1"></div>

                <button type="button"
                        class="icon-btn theme-toggle"
                        id="theme-toggle"
                        title="Toggle theme"
                        @onclick="() => ViewModel.ToggleThemeCommand.ExecuteAsync(null)">
                    <i class="bi @ViewModel.ThemeIcon"></i>
                </button>
            </header>

            <main class="app-content">
@*#if (IncludeNotes)*@
                @if (ViewModel.NeedsFolderAccess)
                {
                    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-3" role="alert" id="folder-access-banner">
                        <i class="bi bi-folder-x fs-5"></i>
                        <span class="flex-grow-1">Your notes are kept in the folder <strong>@(ViewModel.FolderName ?? "you chose")</strong>. Allow access to it again to use them and sync.</span>
                        <button type="button" class="btn btn-warning btn-sm" id="folder-reconnect-button"
                                @onclick="() => ViewModel.ReconnectFolderCommand.ExecuteAsync(null)">
                            <i class="bi bi-folder-check me-1"></i>Reconnect folder
                        </button>
                        @if (!string.IsNullOrEmpty(ViewModel.FolderAccessError))
                        {
                            <div class="w-100 small" id="folder-access-error">@ViewModel.FolderAccessError</div>
                        }
                    </div>
                }
@*#endif*@
                <div class="app-content-body" @key="ViewModel.ContentVersion">
                    @Body
                </div>
            </main>
        </div>
@*#if (IncludeNotes)*@

        <div class="sync-pill-wrap">
            @if (ViewModel.IsSyncPopoverOpen)
            {
                <div class="sync-popover-backdrop" @onclick="() => ViewModel.CloseSyncPopoverCommand.Execute(null)"></div>
                <div class="sync-popover" id="sync-popover" role="dialog" aria-label="Sync">
                    <div class="sync-popover-status">
                        <i class="bi @ViewModel.SyncPill.Icon sync-tone-@ViewModel.SyncPill.Tone"></i>
                        <span id="sync-popover-reason">@ViewModel.SyncPill.Tooltip</span>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" role="switch" id="offline-mode-switch"
                               checked="@ViewModel.IsForcedOffline"
                               @onchange="() => ViewModel.ToggleOfflineModeCommand.ExecuteAsync(null)" />
                        <label class="form-check-label" for="offline-mode-switch">Offline mode</label>
                    </div>
                    <div class="sync-popover-meta">
                        Last synced: <span id="sync-last-synced">@(ViewModel.SyncStatus.LastSyncedAt?.ToLocalTime().ToString("g") ?? "Not yet")</span>
                    </div>
                    <div class="sync-popover-actions">
                        <button type="button" class="btn btn-primary btn-sm" id="sync-now-button"
                                disabled="@(!ViewModel.CanSyncNow)"
                                @onclick="() => ViewModel.SyncNowCommand.ExecuteAsync(null)">
                            <i class="bi bi-arrow-repeat me-1"></i>Sync now
                        </button>
                        <a class="btn btn-link btn-sm" href="sync" id="view-sync-log" @onclick="() => ViewModel.CloseSyncPopoverCommand.Execute(null)">View sync log</a>
                    </div>
                </div>
            }
            <button type="button"
                    class="sync-pill sync-tone-@ViewModel.SyncPill.Tone"
                    id="sync-status-pill"
                    title="@ViewModel.SyncPill.Tooltip"
                    aria-expanded="@ViewModel.IsSyncPopoverOpen.ToString().ToLowerInvariant()"
                    @onclick="() => ViewModel.ToggleSyncPopoverCommand.Execute(null)">
                <i class="bi @ViewModel.SyncPill.Icon @(ViewModel.SyncPill.IsSyncing ? "sync-spin" : null)"></i>
                <span class="sync-pill-text">@ViewModel.SyncPill.Text</span>
            </button>
        </div>
@*#endif*@
    </div>
@*#if (IncludeNotes)*@
    @if (ViewModel.IsStorageMigrating)
    {
        <div class="modal-backdrop show"></div>
        <div class="modal d-block app-modal" role="alertdialog" aria-modal="true" aria-labelledby="storage-migrating-text" id="storage-migrating-overlay">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body d-flex align-items-center gap-3">
                        <span class="spinner-border text-primary flex-shrink-0" aria-hidden="true"></span>
                        <span id="storage-migrating-text">Your notes are being moved to another storage in another tab. This tab reloads when it finishes.</span>
                    </div>
                </div>
            </div>
        </div>
    }
@*#endif*@
}
