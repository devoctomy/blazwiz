@inherits MvvmComponentBase<OfflineModeSwitchViewModel>
@inject IStringLocalizer<UiText> Text

<div class="form-check form-switch mb-0">
    <input class="form-check-input" type="checkbox" role="switch" id="offline-mode-switch"
           checked="@ViewModel.IsOffline"
           disabled="@ViewModel.IsWorking"
           @onchange="() => ViewModel.ToggleCommand.ExecuteAsync(null)" />
    <label class="form-check-label" for="offline-mode-switch">@Text["Offline.Switch.Label"]</label>
</div>
<div class="form-text">@Text["Offline.Switch.Help"]</div>
@if (!string.IsNullOrEmpty(ViewModel.Error))
{
    <div class="text-danger small mt-1" id="offline-mode-error">@ViewModel.Error</div>
}
