@using blazwiz.Portal.Application.Services
@inject StartSyncOffSignInOption Option
@inject IStringLocalizer<SyncUiText> SyncText

<div class="form-check">
    <input type="checkbox"
           id="start-sync-off"
           class="form-check-input"
           @bind="Option.StartWithSyncOff" />
    <label class="form-check-label" for="start-sync-off">@SyncText["Sync.StartOff.Label"]</label>
    <div class="form-text">@SyncText["Sync.StartOff.Help"]</div>
</div>
