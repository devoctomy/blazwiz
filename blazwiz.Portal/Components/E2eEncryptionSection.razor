@inherits MvvmComponentBase<E2eSettingsViewModel>
@using blazwiz.Core.Encryption.Models
@using blazwiz.Portal.Models.Sync

<div class="mt-4" id="e2e-section">
    <h3 class="h6 mb-1"><i class="bi bi-shield-lock me-1"></i>End to end encryption</h3>
    <p class="panel-text mb-2">Encrypts your notes on this device with a key only you hold, so they are synced and stored encrypted. It needs your passkey and a passphrase of your own.</p>
    <p class="mb-2" id="e2e-status">
        <i class="bi @(ViewModel.Status == E2eStatus.Unlocked ? "bi-lock-fill text-success" : ViewModel.Status is E2eStatus.Blocked or E2eStatus.NeedsSetup or E2eStatus.DisabledElsewhere ? "bi-lock-fill text-danger" : "bi-unlock text-body-secondary") me-1"></i>@ViewModel.StatusText
    </p>
    <div class="d-flex flex-wrap gap-2">
        @if (ViewModel.CanEnable)
        {
            <button type="button" class="btn btn-outline-primary" id="e2e-enable"
                    @onclick="() => ViewModel.OpenDialogCommand.Execute(E2eDialogKind.Enable)">
                <i class="bi bi-lock me-1"></i>Enable encryption
            </button>
        }
        @if (ViewModel.CanSetUp)
        {
            <button type="button" class="btn btn-outline-primary" id="e2e-setup"
                    @onclick="() => ViewModel.OpenDialogCommand.Execute(E2eDialogKind.SetUp)">
                <i class="bi bi-key me-1"></i>Set up this device
            </button>
        }
        @if (ViewModel.CanManage)
        {
            <button type="button" class="btn btn-outline-secondary" id="e2e-change"
                    @onclick="() => ViewModel.OpenDialogCommand.Execute(E2eDialogKind.ChangePassphrase)">
                <i class="bi bi-key me-1"></i>Change passphrase
            </button>
            <button type="button" class="btn btn-outline-danger" id="e2e-disable"
                    @onclick="() => ViewModel.OpenDialogCommand.Execute(E2eDialogKind.Disable)">
                <i class="bi bi-unlock me-1"></i>Disable encryption
            </button>
        }
    </div>
</div>

@if (ViewModel.ActiveDialog is E2eDialogKind dialog)
{
    var title = dialog switch
    {
        E2eDialogKind.Enable => "Enable end to end encryption",
        E2eDialogKind.SetUp => "Set up this device",
        E2eDialogKind.ChangePassphrase => "Change passphrase",
        _ => "Disable end to end encryption",
    };
    <ModalDialog Id="e2e-dialog" Title="@title" Icon="bi-shield-lock" OnClose="() => ViewModel.CloseDialogCommand.Execute(null)">
        <ChildContent>
            @if (ViewModel.IsEditing)
            {
                <form id="e2e-form" @onsubmit="() => ViewModel.ConfirmDialogCommand.ExecuteAsync(null)" @onsubmit:preventDefault>
                    @switch (dialog)
                    {
                        case E2eDialogKind.Enable:
                            <p>Your notes will be encrypted on this device before they are synced. Other devices need this passphrase once to be set up.</p>
                            break;
                        case E2eDialogKind.SetUp:
                            <p>Enter the passphrase you chose when you turned encryption on. It is only needed once on this device; after that your passkey unlocks it.</p>
                            break;
                        case E2eDialogKind.ChangePassphrase:
                            <p>Your notes and other devices are not affected. Use the new passphrase when you next set up a device.</p>
                            break;
                        default:
                            <p>Every note will be decrypted on this device, then synced unencrypted. Your keys are deleted, and other devices turn encryption off when they next start.</p>
                            break;
                    }
                    @if (dialog is E2eDialogKind.Enable or E2eDialogKind.ChangePassphrase)
                    {
                        <div class="alert alert-warning" role="alert" id="e2e-no-recovery">
                            <i class="bi bi-exclamation-triangle me-1"></i><strong>@E2eSettingsViewModel.NoRecoveryWarning</strong>
                        </div>
                    }
                    @if (dialog == E2eDialogKind.ChangePassphrase)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="e2e-current-passphrase">Current passphrase</label>
                            <input type="password" class="form-control" id="e2e-current-passphrase" autocomplete="current-password"
                                   @bind="ViewModel.CurrentPassphrase" @bind:event="oninput" />
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label" for="e2e-passphrase">@(dialog is E2eDialogKind.Enable or E2eDialogKind.ChangePassphrase ? "New passphrase" : "Passphrase")</label>
                        <input type="password" class="form-control" id="e2e-passphrase"
                               autocomplete="@(dialog is E2eDialogKind.Enable or E2eDialogKind.ChangePassphrase ? "new-password" : "current-password")"
                               @bind="ViewModel.Passphrase" @bind:event="oninput" />
                    </div>
                    @if (dialog is E2eDialogKind.Enable or E2eDialogKind.ChangePassphrase)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="e2e-confirm-passphrase">Enter the new passphrase again</label>
                            <input type="password" class="form-control" id="e2e-confirm-passphrase" autocomplete="new-password"
                                   @bind="ViewModel.ConfirmPassphrase" @bind:event="oninput" />
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="e2e-acknowledge" @bind="ViewModel.AcknowledgedNoRecovery" />
                            <label class="form-check-label" for="e2e-acknowledge">I understand that if I forget this passphrase, my encrypted notes cannot be recovered.</label>
                        </div>
                    }
                </form>
            }
            else if (ViewModel.Steps.Count > 0)
            {
                <ul class="list-unstyled e2e-steps mb-0" id="e2e-steps">
                    @foreach (var step in ViewModel.Steps)
                    {
                        <li class="d-flex align-items-center gap-2 py-1 e2e-step-@step.State.ToString().ToLowerInvariant()">
                            @switch (step.State)
                            {
                                case E2eStepState.Done:
                                    <i class="bi bi-check-circle-fill text-success" aria-label="Done"></i>
                                    break;
                                case E2eStepState.Running:
                                    <span class="spinner-border spinner-border-sm text-primary" role="status" aria-label="Running"></span>
                                    break;
                                case E2eStepState.Failed:
                                    <i class="bi bi-x-circle-fill text-danger" aria-label="Failed"></i>
                                    break;
                                default:
                                    <i class="bi bi-circle text-body-secondary" aria-label="Waiting"></i>
                                    break;
                            }
                            <span>@step.Label</span>
                            @if (step.Detail != null)
                            {
                                <span class="text-body-secondary small ms-auto">@step.Detail</span>
                            }
                        </li>
                    }
                </ul>
                @if (ViewModel.IsFinished)
                {
                    <div class="text-center mt-4" id="e2e-finished">
                        @if (dialog == E2eDialogKind.Enable)
                        {
                            <i class="bi bi-shield-lock-fill text-success display-4"></i>
                            <p class="h5 mt-2 mb-0">E2E Encryption Enabled</p>
                        }
                        else
                        {
                            <i class="bi bi-unlock text-body-secondary display-4"></i>
                            <p class="h5 mt-2 mb-0">E2E Encryption Disabled</p>
                        }
                    </div>
                }
            }
            else if (ViewModel.IsWorking)
            {
                <p class="mb-0" id="e2e-working">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Deriving your passphrase key… this can take a few seconds.
                </p>
            }
            else if (ViewModel.IsFinished)
            {
                <div class="text-center" id="e2e-finished">
                    <i class="bi bi-shield-lock-fill text-success display-4"></i>
                    <p class="h5 mt-2 mb-0">@(dialog == E2eDialogKind.SetUp ? "This device is set up" : "Passphrase changed")</p>
                </div>
            }
            @if (!string.IsNullOrEmpty(ViewModel.DialogError))
            {
                <div class="text-danger mt-3" id="e2e-error">@ViewModel.DialogError</div>
            }
        </ChildContent>
        <Footer>
            @if (ViewModel.IsEditing)
            {
                <button type="button" class="btn btn-secondary" @onclick="() => ViewModel.CloseDialogCommand.Execute(null)">Cancel</button>
                <button type="submit" form="e2e-form" class="btn @(dialog == E2eDialogKind.Disable ? "btn-danger" : "btn-primary")" id="e2e-confirm">
                    @(dialog switch
                    {
                        E2eDialogKind.Enable => "Enable encryption",
                        E2eDialogKind.SetUp => "Set up",
                        E2eDialogKind.ChangePassphrase => "Change passphrase",
                        _ => "Disable encryption",
                    })
                </button>
            }
            else
            {
                <button type="button" class="btn btn-primary" id="e2e-close" disabled="@ViewModel.IsWorking"
                        @onclick="() => ViewModel.CloseDialogCommand.Execute(null)">Close</button>
            }
        </Footer>
    </ModalDialog>
}
