<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Every security rule (CA3xxx, CA5xxx), not just the few on by default. -->
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Analyzer rules turned off for the whole solution (including SA1633, the file header). -->
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)analyzers.globalconfig" />
  </ItemGroup>
</Project>
