<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>
  <!-- Release builds are stamped with when they were built (UTC), shown in Settings > About, so a deployed build can be
       told apart from the last one. Debug builds are not, so they still build incrementally. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm'))" />
  </ItemGroup>
  <!--
    Uncomment for smaller / faster production builds once the wasm-tools workload is installed
    (dotnet workload install wasm-tools). AOT makes publishing considerably slower.
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmEnableSIMD>true</WasmEnableSIMD>
  </PropertyGroup>
  -->
  <ItemGroup>
    <PackageReference Include="Blazing.Mvvm" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyApp.Portal.Application\MyApp.Portal.Application.csproj" />
    <ProjectReference Include="..\MyApp.Portal.Models\MyApp.Portal.Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
