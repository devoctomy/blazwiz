<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <!-- Formatting data (dates, numbers) for every culture, so the app can switch language at runtime. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <!-- Release builds are stamped with when they were built (UTC), shown in Settings > About, so a deployed build can be
       told apart from the last one. Debug builds are not, so they still build incrementally. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm'))" />
  </ItemGroup>
  <!--
    The optimal production build: compiled ahead of time to WebAssembly, with SIMD, so it runs several times faster
    (Argon2id most of all). Needs the wasm-tools workload (dotnet workload install wasm-tools); the download is larger
    and publishing takes minutes. Uncomment to publish this way every time, or deploy with cloudformation/deploy.ps1 -Aot.
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmEnableSIMD>true</WasmEnableSIMD>
  </PropertyGroup>
  -->
  <ItemGroup>
    <PackageReference Include="Blazing.Mvvm" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- The AWS base stack and deploy scripts at the framework's version, run by cloudformation/deploy.ps1. -->
    <PackageReference Include="Devoctomy.Blazwiz.Aws" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyApp.Portal.Application\MyApp.Portal.Application.csproj" />
    <ProjectReference Include="..\MyApp.Portal.Models\MyApp.Portal.Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
<!--#if (IncludeSync)-->
  <ItemGroup>
    <EmbeddedResource Include="sync.json" LogicalName="sync.json" />
    <Content Remove="sync.json" />
  </ItemGroup>
<!--#endif-->
</Project>
