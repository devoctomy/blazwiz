<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Abort the whole run if it takes longer than 15 minutes: a cold Release build of the portal (as on a CI runner)
         takes minutes, then the tests about two. -->
    <TestSessionTimeout>900000</TestSessionTimeout>
  </RunConfiguration>
  <MSTest>
    <!-- Fail any single test that takes longer than 30 seconds rather than hanging. -->
    <TestTimeout>30000</TestTimeout>
  </MSTest>
</RunSettings>
