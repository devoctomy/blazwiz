<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>blazwiz.Portal.Application</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Extensions.CognitoAuthentication" />
<!--#if (IncludeNotes)-->
    <PackageReference Include="AWSSDK.CognitoIdentity" />
<!--#endif-->
    <PackageReference Include="AWSSDK.CognitoIdentityProvider" />
    <PackageReference Include="Blazing.Mvvm" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.JSInterop" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
<!--#if (IncludeNotes)-->
    <PackageReference Include="Markdig" />
<!--#endif-->
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\blazwiz.Core\blazwiz.Core.csproj" />
    <ProjectReference Include="..\blazwiz.Portal.Models\blazwiz.Portal.Models.csproj" />
  </ItemGroup>
<!--#if (IncludeNotes)-->
  <ItemGroup>
    <EmbeddedResource Include="Resources\WelcomeNote.md" LogicalName="WelcomeNote.md" />
  </ItemGroup>
<!--#endif-->
</Project>
