@using Devoctomy.Blazwiz.UI.Sync.Models
@inject IStringLocalizer<UiText> Text
@inject IStringLocalizer<SyncUiText> SyncText

@if (Model.ActiveDialog is E2eDialogKind dialog)
{
    <ModalDialog Id="e2e-dialog" Title="@Model.DialogTitle" Icon="bi-shield-lock" OnClose="CloseAsync">
        <ChildContent>
            @if (Model.IsEditing)
            {
                <form id="e2e-form" @onsubmit="() => Model.ConfirmDialogCommand.ExecuteAsync(null)" @onsubmit:preventDefault>
                    @if (Model.AsksForNewPassphrase)
                    {
                        <E2ePassphraseForm Form="Model.PassphraseForm" IdPrefix="e2e">
                            <p>@Model.DialogText</p>
                            <div class="alert alert-warning" role="alert" id="e2e-no-recovery">
                                <i class="bi bi-exclamation-triangle me-1"></i><strong>@Model.NoRecoveryWarning</strong>
                            </div>
                        </E2ePassphraseForm>
                    }
                    else
                    {
                        <p>@Model.DialogText</p>
                        @if (dialog == E2eDialogKind.FinishRotation)
                        {
                            <div class="alert alert-warning mb-0" role="alert" id="e2e-rotation-warning">
                                <i class="bi bi-exclamation-triangle me-1"></i>@Model.RotationWarning
                            </div>
                        }
                        else if (dialog == E2eDialogKind.Delete)
                        {
                            <div class="mb-3">
                                <label class="form-label" for="e2e-delete-confirmation">@SyncText["Sync.E2e.DeleteConfirmation", Model.DialogProfile?.Id ?? string.Empty]</label>
                                <input type="text" class="form-control" id="e2e-delete-confirmation" autocomplete="off"
                                       @bind="Model.DeleteConfirmation" @bind:event="oninput" />
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label" for="e2e-passphrase">@SyncText["Sync.E2e.Passphrase"]</label>
                                <input type="password" class="form-control" id="e2e-passphrase" autocomplete="current-password"
                                       @bind="Model.Passphrase" @bind:event="oninput" />
                            </div>
                        }
                    }
                </form>
            }
            else if (Model.IsConfirmingRotation)
            {
                <div id="e2e-rotation-confirm">
                    <p id="e2e-rotation-estimate">@Model.EstimateText</p>
                    <div class="alert alert-warning mb-0" role="alert" id="e2e-rotation-warning">
                        <i class="bi bi-exclamation-triangle me-1"></i>@Model.RotationWarning
                    </div>
                </div>
            }
            else if (Model.Steps.Count > 0)
            {
                @if (Model.FilesTotal > 0)
                {
                    <div class="progress mb-3" role="progressbar" id="e2e-rotation-progress" aria-label="@SyncText["Sync.E2e.Step.ReencryptFiles"]"
                         aria-valuenow="@Model.FilesPercent" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: @(Model.FilesPercent)%"></div>
                    </div>
                }
                <ul class="list-unstyled e2e-steps mb-0" id="e2e-steps">
                    @foreach (var step in Model.Steps)
                    {
                        <li class="d-flex align-items-center gap-2 py-1 e2e-step-@step.State.ToString().ToLowerInvariant()">
                            @switch (step.State)
                            {
                                case E2eStepState.Done:
                                    <i class="bi bi-check-circle-fill text-success" aria-label="@SyncText["Sync.E2e.Step.Done"]"></i>
                                    break;
                                case E2eStepState.Running:
                                    <span class="spinner-border spinner-border-sm text-primary" role="status" aria-label="@SyncText["Sync.E2e.Step.Running"]"></span>
                                    break;
                                case E2eStepState.Failed:
                                    <i class="bi bi-x-circle-fill text-danger" aria-label="@SyncText["Sync.E2e.Step.Failed"]"></i>
                                    break;
                                default:
                                    <i class="bi bi-circle text-body-secondary" aria-label="@SyncText["Sync.E2e.Step.Waiting"]"></i>
                                    break;
                            }
                            <span>@step.Label</span>
                            @if (step.Detail != null)
                            {
                                <span class="text-body-secondary small ms-auto">@step.Detail</span>
                            }
                        </li>
                    }
                </ul>
                @if (Model.IsFinished)
                {
                    @Finished()
                }
            }
            else if (Model.IsWorking)
            {
                <p class="mb-0" id="e2e-working">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@Model.WorkingText
                </p>
            }
            else if (Model.IsFinished)
            {
                @Finished()
            }
            @if (!string.IsNullOrEmpty(Model.DialogError))
            {
                <div class="text-danger mt-3" id="e2e-error">@Model.DialogError</div>
            }
        </ChildContent>
        <Footer>
            @if (Model.IsEditing)
            {
                <button type="button" class="btn btn-secondary" @onclick="CloseAsync">@Text["Common.Cancel"]</button>
                <button type="submit" form="e2e-form" class="btn @(dialog == E2eDialogKind.Delete ? "btn-danger" : "btn-primary")" id="e2e-confirm" disabled="@(!Model.CanConfirmDialog)">@Model.DialogTitle</button>
            }
            else if (Model.IsConfirmingRotation)
            {
                <button type="button" class="btn btn-secondary" @onclick="CloseAsync">@Text["Common.Cancel"]</button>
                <button type="button" class="btn btn-primary" id="e2e-rotation-start"
                        @onclick="() => Model.StartRotationCommand.ExecuteAsync(null)">@Model.DialogTitle</button>
            }
            else if (Model.NeedsSignOut)
            {
                <button type="button" class="btn btn-secondary" id="e2e-close" disabled="@Model.IsWorking"
                        @onclick="CloseAsync">@Text["Common.Close"]</button>
                <button type="button" class="btn btn-primary" id="e2e-rotation-sign-out" disabled="@Model.IsWorking"
                        @onclick="() => Model.RetrySignOutCommand.ExecuteAsync(null)">@SyncText["Sync.E2e.Rotation.SignOut"]</button>
            }
            else
            {
                <button type="button" class="btn btn-primary" id="e2e-close" disabled="@Model.IsWorking"
                        @onclick="CloseAsync">@Text["Common.Close"]</button>
            }
        </Footer>
    </ModalDialog>
}

@code {
    private RenderFragment Finished() => @<div class="text-center mt-4" id="e2e-finished">
        <i class="bi bi-shield-lock-fill text-success display-4"></i>
        <p class="h5 mt-2 mb-0">@Model.FinishedText</p>
    </div>;
}
