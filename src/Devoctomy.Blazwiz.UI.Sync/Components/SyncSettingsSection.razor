@inherits MvvmComponentBase<SyncSettingsViewModel>
@using Devoctomy.Blazwiz.Sync.Models
@inject IStringLocalizer<UiText> Text
@inject IStringLocalizer<SyncUiText> SyncText
@inject Devoctomy.Blazwiz.Core.Text.Interfaces.ITextPlurals Plurals

<div class="panel mb-4" id="sync-card">
    <h2 class="panel-title">@SyncText["Sync.Settings.Title"]</h2>
    <p class="panel-text">@SyncText["Sync.Settings.Text"]</p>
    <dl class="detail-list">
        <dt>@SyncText["Sync.Settings.State"]</dt>
        <dd id="settings-sync-state"><i class="bi @ViewModel.SyncDisplay.Icon sync-tone-@ViewModel.SyncDisplay.Tone me-1"></i>@ViewModel.SyncDisplay.Text</dd>
        <dt>@SyncText["Sync.Settings.Connection"]</dt>
        <dd id="settings-connectivity">@ViewModel.ConnectivityText</dd>
        <dt>@SyncText["Sync.LastSynced"]</dt>
        <dd id="settings-last-synced">@(ViewModel.SyncStatus.LastSyncedAt?.ToLocalTime().ToString("g") ?? SyncText["Sync.LastSynced.NotYet"])</dd>
        <dt>@SyncText["Sync.PendingChanges"]</dt>
        <dd id="settings-pending">@ViewModel.SyncStatus.PendingCount</dd>
        @if (!string.IsNullOrEmpty(ViewModel.LastErrorText))
        {
            <dt>@SyncText["Sync.Settings.LastError"]</dt>
            <dd id="settings-last-error" class="text-danger">@ViewModel.LastErrorText</dd>
        }
        <dt>@SyncText["Sync.Settings.Storage"]</dt>
        <dd id="storage-status">
            @if (ViewModel.IsStoragePersisted)
            {
                <span class="text-success"><i class="bi bi-check-lg me-1"></i>@ViewModel.StorageText</span>
            }
            else if (ViewModel.IsStorageKnown)
            {
                <span class="text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>@ViewModel.StorageText</span>
                @if (ViewModel.ShowInstallHint)
                {
                    <div class="form-text" id="storage-install-hint">@ViewModel.InstallHint</div>
                }
            }
            else
            {
                <span class="text-body-secondary">@ViewModel.StorageText</span>
            }
        </dd>
    </dl>
    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
        <button type="button" class="btn btn-primary" id="settings-sync-now"
                disabled="@(!ViewModel.CanSyncNow)"
                @onclick="() => ViewModel.SyncNowCommand.ExecuteAsync(null)">
            <i class="bi bi-arrow-repeat me-1"></i>@SyncText["Sync.SyncNow"]
        </button>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="settings-sync-switch"
                   checked="@ViewModel.IsSyncEnabled"
                   @onchange="() => ViewModel.ToggleSyncCommand.ExecuteAsync(null)" />
            <label class="form-check-label" for="settings-sync-switch">@SyncText["Sync.Switch"]</label>
        </div>
        <a href="sync" class="btn btn-link">@SyncText["Sync.ViewLog"]</a>
    </div>
    @if (ViewModel.CanSwitchStorage)
    {
        <div class="mt-4" id="storage-location">
            <h3 class="h6 mb-1">@SyncText["Sync.Storage.Location"]</h3>
            <p class="panel-text mb-2">@SyncText["Sync.Storage.Location.Text"]</p>
            <div class="btn-group flex-wrap" role="group" aria-label="@SyncText["Sync.Storage.Location"]">
                <button type="button" id="storage-option-indexeddb"
                        class="btn btn-outline-primary @(ViewModel.StorageKind == SyncStorageKind.IndexedDb ? "active" : null)"
                        aria-pressed="@(ViewModel.StorageKind == SyncStorageKind.IndexedDb ? "true" : "false")"
                        disabled="@ViewModel.IsMigrating"
                        title="@SyncText["Sync.Storage.Kind.IndexedDb.Tooltip"]"
                        @onclick="() => ViewModel.RequestStorageChangeCommand.ExecuteAsync(SyncStorageKind.IndexedDb)">
                    <i class="bi bi-database me-1"></i>@ViewModel.GetStorageName(SyncStorageKind.IndexedDb)
                </button>
                <button type="button" id="storage-option-opfs"
                        class="btn btn-outline-primary @(ViewModel.StorageKind == SyncStorageKind.Opfs ? "active" : null)"
                        aria-pressed="@(ViewModel.StorageKind == SyncStorageKind.Opfs ? "true" : "false")"
                        disabled="@(ViewModel.IsMigrating || !ViewModel.IsOpfsSupported)"
                        title="@(ViewModel.IsOpfsSupported ? SyncText["Sync.Storage.Kind.Opfs.Tooltip"] : SyncText["Sync.Storage.Kind.Opfs.Unsupported"])"
                        @onclick="() => ViewModel.RequestStorageChangeCommand.ExecuteAsync(SyncStorageKind.Opfs)">
                    <i class="bi bi-hdd me-1"></i>@ViewModel.GetStorageName(SyncStorageKind.Opfs)
                </button>
                <button type="button" id="storage-option-folder"
                        class="btn btn-outline-primary @(ViewModel.StorageKind == SyncStorageKind.LocalFolder ? "active" : null)"
                        aria-pressed="@(ViewModel.StorageKind == SyncStorageKind.LocalFolder ? "true" : "false")"
                        disabled="@(ViewModel.IsMigrating || !ViewModel.IsFolderSupported)"
                        title="@(ViewModel.IsFolderSupported ? SyncText["Sync.Storage.Kind.LocalFolder.Tooltip"] : SyncText["Sync.Storage.Kind.LocalFolder.Unsupported"])"
                        @onclick="() => ViewModel.RequestStorageChangeCommand.ExecuteAsync(SyncStorageKind.LocalFolder)">
                    <i class="bi bi-folder2-open me-1"></i>@ViewModel.GetStorageName(SyncStorageKind.LocalFolder)
                </button>
            </div>
            @if (ViewModel.StorageKind == SyncStorageKind.LocalFolder && !string.IsNullOrEmpty(ViewModel.FolderName))
            {
                <div class="form-text" id="storage-folder-name"><i class="bi bi-folder2-open me-1"></i>@SyncText["Sync.Storage.Folder", ViewModel.FolderName ?? string.Empty]</div>
            }
            @if (!string.IsNullOrEmpty(ViewModel.StorageError))
            {
                <div class="text-danger mt-2" id="storage-error">@ViewModel.StorageError</div>
            }
        </div>
    }
    <E2eProfilesSection />
</div>

@if (ViewModel.IsStorageDialogOpen)
{
    <ModalDialog Id="storage-dialog" Title="@SyncText["Sync.Storage.Dialog.Title"]" Icon="bi-arrow-left-right" OnClose="() => ViewModel.CloseStorageDialogCommand.Execute(null)">
        <ChildContent>
            @if (ViewModel.IsMigrating)
            {
                <p class="mb-0" id="storage-migration-progress">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>@(ViewModel.MigrationText ?? SyncText["Sync.Storage.Dialog.Pausing"])
                </p>
            }
            else
            {
                <p id="storage-dialog-summary">@Plurals.Format(SyncText, "Sync.Storage.Dialog.Summary", ViewModel.PendingFileCount, ViewModel.PendingStorageName ?? string.Empty)</p>
                <p class="mb-0">@SyncText["Sync.Storage.Dialog.Text"]</p>
            }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" disabled="@ViewModel.IsMigrating" @onclick="() => ViewModel.CloseStorageDialogCommand.Execute(null)">@Text["Common.Cancel"]</button>
            <button type="button" class="btn btn-primary" id="storage-confirm" disabled="@ViewModel.IsMigrating" @onclick="() => ViewModel.ConfirmStorageChangeCommand.ExecuteAsync(null)">@SyncText["Sync.Storage.Dialog.Confirm"]</button>
        </Footer>
    </ModalDialog>
}
