<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <Description>User events for blazwiz apps over AWS AppSync Events: each user's channel reaches all their open devices, authorised with the Cognito sign in. No Amplify: the protocol is spoken directly.</Description>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Devoctomy.Blazwiz.Events\Devoctomy.Blazwiz.Events.csproj" />
    <ProjectReference Include="..\Devoctomy.Blazwiz.Auth.Cognito\Devoctomy.Blazwiz.Auth.Cognito.csproj" />
  </ItemGroup>
</Project>
