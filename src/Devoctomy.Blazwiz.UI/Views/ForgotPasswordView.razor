@using Devoctomy.Blazwiz.UI.Models
@using Devoctomy.Blazwiz.UI.Text
@using Devoctomy.Blazwiz.UI.ViewModels
@inherits MvvmComponentBase<ForgotPasswordViewModel>
@inject IStringLocalizer<UiText> Text

<PageTitle>@Text["ForgotPassword.PageTitle", ViewModel.AppSettings.ApplicationTitle]</PageTitle>

<div class="auth-card">
    <div class="auth-header">
        <img src="images/icon.svg" class="auth-logo" alt="@ViewModel.AppSettings.ApplicationTitle" />
        <h1 class="auth-title" id="forgot-password-title">@Text["ForgotPassword.Title"]</h1>
    </div>

    @if (ViewModel.Step == ForgotPasswordStep.Request)
    {
        <EditForm Model="ViewModel" OnSubmit="() => ViewModel.RequestCodeCommand.ExecuteAsync(null)" FormName="forgot-password-request">
            <p class="small mb-3" id="forgot-password-intro">@Text["ForgotPassword.Request.Intro"]</p>
            <div class="mb-3">
                <label for="reset-email" class="form-label">@Text["ForgotPassword.Email"]</label>
                <div class="input-icon">
                    <i class="bi bi-person"></i>
                    <InputText id="reset-email"
                               type="email"
                               class="form-control"
                               autocomplete="username"
                               @bind-Value="ViewModel.Email"
                               disabled="@ViewModel.IsBusy" />
                </div>
            </div>

            <ErrorAlert Message="@ViewModel.ErrorMessage" />

            <button type="submit" class="btn btn-primary btn-lg w-100" id="send-code-button" disabled="@ViewModel.IsBusy">
                @(ViewModel.IsBusy ? Text["ForgotPassword.Sending"] : Text["ForgotPassword.SendCode"])
            </button>
        </EditForm>
    }
    else if (ViewModel.Step == ForgotPasswordStep.Reset)
    {
        <EditForm Model="ViewModel" OnSubmit="() => ViewModel.ResetPasswordCommand.ExecuteAsync(null)" FormName="forgot-password-reset">
            <p class="small mb-3" id="reset-intro">@Text["ForgotPassword.Reset.Intro", ViewModel.Email]</p>
            <div class="mb-3">
                <label for="reset-code" class="form-label">@Text["ForgotPassword.Code"]</label>
                <div class="input-icon">
                    <i class="bi bi-shield-lock"></i>
                    <InputText id="reset-code"
                               type="text"
                               class="form-control"
                               autocomplete="one-time-code"
                               @bind-Value="ViewModel.Code"
                               disabled="@ViewModel.IsBusy" />
                </div>
            </div>
            <div class="mb-3">
                <label for="reset-new-password" class="form-label">@Text["ForgotPassword.NewPassword"]</label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <InputText id="reset-new-password"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               @bind-Value="ViewModel.NewPassword"
                               disabled="@ViewModel.IsBusy" />
                </div>
            </div>
            <div class="mb-3">
                <label for="reset-confirm-password" class="form-label">@Text["ForgotPassword.Confirm"]</label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <InputText id="reset-confirm-password"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               @bind-Value="ViewModel.ConfirmNewPassword"
                               disabled="@ViewModel.IsBusy" />
                </div>
            </div>

            <ErrorAlert Message="@ViewModel.ErrorMessage" />

            <button type="submit" class="btn btn-primary btn-lg w-100" id="reset-password-button" disabled="@ViewModel.IsBusy">
                @(ViewModel.IsBusy ? Text["ForgotPassword.Resetting"] : Text["ForgotPassword.Submit"])
            </button>
            <button type="button" class="btn btn-link w-100 mt-2" id="resend-code" disabled="@ViewModel.IsBusy" @onclick="ViewModel.StartAgainCommand.Execute">
                @Text["ForgotPassword.ResendCode"]
            </button>
        </EditForm>
    }
    else
    {
        <div class="alert alert-success small" role="status" id="reset-done">
            <i class="bi bi-check-circle me-1"></i>@Text["ForgotPassword.Done"]
        </div>
    }

    <button type="button" class="btn btn-link w-100 mt-2" id="back-to-sign-in" @onclick="ViewModel.BackToSignInCommand.Execute">
        <i class="bi bi-arrow-left me-1"></i>@Text["ForgotPassword.BackToSignIn"]
    </button>
</div>
