@using Devoctomy.Blazwiz.UI.Text
@using Devoctomy.Blazwiz.UI.ViewModels
@inherits MvvmComponentBase<OfflineBannerViewModel>
@inject IStringLocalizer<UiText> Text

@if (ViewModel.IsVisible)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-3" role="status" id="offline-banner">
        <i class="bi bi-wifi-off fs-5"></i>
        <span class="flex-grow-1" id="offline-banner-text">@ViewModel.Message</span>
        <button type="button" class="btn btn-outline-primary btn-sm" id="offline-banner-sign-in"
                @onclick="() => ViewModel.SignInOnlineCommand.Execute(null)">
            <i class="bi bi-box-arrow-in-right me-1"></i>@Text["Offline.Banner.SignInOnline"]
        </button>
    </div>
}
