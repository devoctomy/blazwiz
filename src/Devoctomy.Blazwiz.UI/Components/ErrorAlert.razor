@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-danger py-2 small" role="alert" id="@Id">
        <i class="bi bi-exclamation-triangle me-1"></i>@Message
    </div>
}

@code {
    /// <summary>
    /// Gets or sets the error to show; nothing is shown when it is empty.
    /// </summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>
    /// Gets or sets the element's id.
    /// </summary>
    [Parameter]
    public string Id { get; set; } = "form-error";
}
