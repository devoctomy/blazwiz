@using Devoctomy.Blazwiz.UI.Text
@using Devoctomy.Blazwiz.UI.ViewModels
@inherits MvvmComponentBase<ChangePasswordViewModel>
@inject IStringLocalizer<UiText> Text

<div class="panel mt-4" id="change-password">
    <h2 class="panel-title">@Text["Profile.ChangePassword.Title"]</h2>
    <EditForm Model="ViewModel" OnSubmit="() => ViewModel.ChangePasswordCommand.ExecuteAsync(null)" FormName="change-password">
        <div class="mb-3">
            <label for="current-password" class="form-label">@Text["Profile.ChangePassword.Current"]</label>
            <div class="input-icon">
                <i class="bi bi-lock"></i>
                <InputText id="current-password"
                           type="password"
                           class="form-control"
                           autocomplete="current-password"
                           @bind-Value="ViewModel.CurrentPassword"
                           disabled="@ViewModel.IsBusy" />
            </div>
        </div>
        <div class="mb-3">
            <label for="change-new-password" class="form-label">@Text["Profile.ChangePassword.New"]</label>
            <div class="input-icon">
                <i class="bi bi-lock"></i>
                <InputText id="change-new-password"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           @bind-Value="ViewModel.NewPassword"
                           disabled="@ViewModel.IsBusy" />
            </div>
        </div>
        <div class="mb-3">
            <label for="change-confirm-password" class="form-label">@Text["Profile.ChangePassword.Confirm"]</label>
            <div class="input-icon">
                <i class="bi bi-lock"></i>
                <InputText id="change-confirm-password"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           @bind-Value="ViewModel.ConfirmNewPassword"
                           disabled="@ViewModel.IsBusy" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
        {
            <div class="alert alert-danger py-2 small" role="alert" id="change-password-error">
                <i class="bi bi-exclamation-triangle me-1"></i>@ViewModel.ErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(ViewModel.SuccessMessage))
        {
            <div class="alert alert-success py-2 small" role="status" id="change-password-done">
                <i class="bi bi-check-circle me-1"></i>@ViewModel.SuccessMessage
            </div>
        }

        <button type="submit" class="btn btn-primary" id="change-password-button" disabled="@ViewModel.IsBusy">
            @if (ViewModel.IsBusy)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span>@Text["Profile.ChangePassword.Changing"]</span>
            }
            else
            {
                <span>@Text["Profile.ChangePassword.Submit"]</span>
            }
        </button>
    </EditForm>
</div>
