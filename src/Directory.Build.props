<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>blazor;webassembly;pwa;blazwiz</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- From 1.0, packing checks each package against the latest release: the release workflow and
         templatepack/test-template.ps1 pass -p:PackageValidationBaselineVersion from eng/get-validation-baseline.ps1.
         A binary breaking change then fails unless it is recorded in the package's CompatibilitySuppressions.xml
         (docs/versioning.md). Before 1.0 there is no baseline: any release may break. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Every public API change shows up in PublicAPI.Unshipped.txt, so it is reviewed (docs/versioning.md). Moved to
         PublicAPI.Shipped.txt when a version is released. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
    <!-- Each package's own README.md, shown on nuget.org. Pack fails if a package has none (NU5039). -->
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
