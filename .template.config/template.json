{
  "$schema": "http://json.schemastore.org/template",
  "author": "Nick Pateman",
  "classifications": [ "Web", "Blazor", "WebAssembly", "PWA", "AWS", "Cognito" ],
  "identity": "Devoctomy.Blazwiz",
  "name": "Blazor WebAssembly PWA with AWS Cognito (blazwiz)",
  "description": "A Blazor WebAssembly progressive web app that signs in with AWS Cognito, with CloudFormation scripts to host it on S3 and CloudFront.",
  "shortName": "blazwiz",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "preferNameDirectory": true,
  "symbols": {
    "Title": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "displayName": "Title",
      "description": "Shown in the browser tab, on the login page, in the PWA manifest and in the copyright. Defaults to the name. Avoid quotes."
    },
    "Description": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "Sign in to continue.",
      "displayName": "Description",
      "description": "Shown under the title on the login page.",
      "replaces": "Sign in to continue.",
      "onlyIf": [ { "after": "\"ApplicationDescription\": \"" } ]
    },
    "IncludeTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Include tests",
      "description": "Include the unit, integration and UI test projects."
    },
    "IncludeShowcase": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "displayName": "Include the Showcase page",
      "description": "Include the Showcase page of themed buttons, alerts, forms and tables to copy from."
    },
    "appNamespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "namespace",
      "fileRename": "blazwiz",
      "description": "The name with the user's casing, made valid for C# (projects, namespaces, folders and files)."
    },
    "appNamespaceDot": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "namespaceDot",
      "replaces": "blazwiz.",
      "description": "Replaces 'blazwiz.' (projects, namespaces, file names). Longer than 'blazwiz', so it takes precedence over appSlug."
    },
    "appSlug": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "slug",
      "replaces": "blazwiz",
      "description": "Lower case letters and numbers, starting with a letter: AWS stack, bucket and role names, and browser storage keys."
    },
    "appPascal": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "pascal",
      "replaces": "Blazwiz",
      "description": "Identifiers such as AddBlazwizCoreServices."
    },
    "appUpper": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "upper",
      "replaces": "BLAZWIZ",
      "description": "Environment variable prefixes such as BLAZWIZ_UITEST_URL."
    },
    "appTitle": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "Title",
        "fallbackVariableName": "name"
      },
      "replaces": "blazwiz",
      "onlyIf": [
        { "after": "\"ApplicationTitle\": \"" },
        { "after": "\"CopyrightMessage\": \"© 2026 " },
        { "after": "<title>" },
        { "after": "apple-mobile-web-app-title\" content=\"" },
        { "after": "\"name\": \"" },
        { "after": "\"short_name\": \"" },
        { "after": "ApplicationTitle { get; set; } = \"" },
        { "after": "Assert.Equal(\"" },
        { "after": "ToHaveTitleAsync(\"Sign in - " },
        { "after": "ToHaveTextAsync(\"" },
        { "after": "# " }
      ]
    },
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "parameters": {
        "format": "yyyy"
      },
      "replaces": "2026",
      "onlyIf": [ { "after": "© " } ]
    }
  },
  "forms": {
    "namespace": {
      "identifier": "chain",
      "steps": [ "invalidToUnderscore", "prefixLeadingDigitWithUnderscore" ]
    },
    "namespaceDot": {
      "identifier": "chain",
      "steps": [ "invalidToUnderscore", "prefixLeadingDigitWithUnderscore", "appendDot" ]
    },
    "slug": {
      "identifier": "chain",
      "steps": [ "lowerCaseInvariant", "removeNonLowerAlphanumeric", "prefixLeadingDigitWithLetter", "truncateTo21" ]
    },
    "pascal": {
      "identifier": "chain",
      "steps": [ "removeNonAlphanumeric", "firstUpperCaseInvariant", "prefixLeadingDigitWithUnderscore" ]
    },
    "upper": {
      "identifier": "chain",
      "steps": [ "upperCaseInvariant", "nonUpperAlphanumericToUnderscore", "prefixLeadingDigitWithUnderscore" ]
    },
    "invalidToUnderscore": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "prefixLeadingDigitWithUnderscore": {
      "identifier": "replace",
      "pattern": "^([0-9])",
      "replacement": "_$1"
    },
    "appendDot": {
      "identifier": "replace",
      "pattern": "$",
      "replacement": "."
    },
    "removeNonLowerAlphanumeric": {
      "identifier": "replace",
      "pattern": "[^a-z0-9]",
      "replacement": ""
    },
    "prefixLeadingDigitWithLetter": {
      "identifier": "replace",
      "pattern": "^([0-9])",
      "replacement": "a$1"
    },
    "truncateTo21": {
      "identifier": "replace",
      "pattern": "^(.{21}).+$",
      "replacement": "$1"
    },
    "removeNonAlphanumeric": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9]",
      "replacement": ""
    },
    "nonUpperAlphanumericToUnderscore": {
      "identifier": "replace",
      "pattern": "[^A-Z0-9]",
      "replacement": "_"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        ".git/**",
        ".vs/**",
        ".idea/**",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/TestResults/**",
        "**/*.user",
        "publish/**",
        "templatepack/**",
        "**/appsettings.Production.json"
      ],
      "modifiers": [
        {
          "condition": "(!IncludeTests)",
          "exclude": [
            "blazwiz.Core.UnitTests/**",
            "blazwiz.Core.IntTests/**",
            "blazwiz.Portal.Application.UnitTests/**",
            "blazwiz.Portal.UITests/**"
          ]
        },
        {
          "condition": "(!IncludeShowcase)",
          "exclude": [
            "blazwiz.Portal/Pages/Showcase.razor",
            "blazwiz.Portal/Pages/Showcase.razor.cs"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "blazwiz.slnx" }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages.",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
